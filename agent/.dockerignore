# Keep the build context small and secrets out of the image.
.venv
.pytest_cache
.ruff_cache
__pycache__
*.py[cod]
.coverage
tests
audit.db
audit.db-*
*.log
# Secrets — provided at runtime via `fly secrets`, never baked in.
.env
.env.*
cdp_api_key.json
cdp_wallet_secret.txt
Dockerfile
.dockerignore
