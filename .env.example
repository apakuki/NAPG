# Copy to .env and fill in. Never commit .env.

# --- Reasoning layer ---
# Direct Anthropic SDK (Claude Opus-class). See https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Onchain execution / wallet ---
# Coinbase Developer Platform (MPC wallet, AgentKit). See https://portal.cdp.coinbase.com/
# Server Wallet v1 was deprecated 2026-02-02; these are v2 keys. CDP_WALLET_SECRET
# is generated alongside the API key in the CDP portal.
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=
CDP_WALLET_SECRET=
# Optional: address of an existing agent account to load. Leave blank to let
# CDP create a fresh account on first run; record the address it returns here
# so subsequent runs reuse the same wallet.
CDP_AGENT_ADDRESS=
# Address to migrate funds to when a Service Level Breach demands action.
# Phase 1: any testnet address you control. Phase 5: a vetted safe contract.
NAPG_SAFE_CONTRACT_ADDRESS=

# --- RPC ---
# Base mainnet + Sepolia endpoints (Alchemy, Infura, QuickNode, or self-hosted)
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=
# Optional fallback endpoints. When set, the heartbeat uses a circuit-breaker
# to cut over to the fallback after repeated failures on the primary; the
# rate-limiter still applies per provider. Use a different provider than the
# primary so a provider-wide outage doesn't take both down.
BASE_RPC_URL_FALLBACK=
BASE_SEPOLIA_RPC_URL_FALLBACK=

# --- Security layer ---
# Tenderly simulation API. See https://dashboard.tenderly.co/
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=
TENDERLY_ACCESS_KEY=

# --- Market data ---
# 0x API for pool liquidity probes. See https://0x.org/docs/api
ZEROX_API_KEY=

# --- Distribution / identity ---
# Farcaster (SIWF) and Neynar for cast-driven onboarding
NEYNAR_API_KEY=
FARCASTER_SIGNER_UUID=

# --- Frontend session signing (Phase 3) ---
# HMAC key for the napg_session cookie issued by the Next.js app. Lives in
# frontend/.env.local at dev time (gitignored); Phase 5 moves it to Fly secrets.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NAPG_SESSION_SECRET=

# --- Runtime ---
# Network the agent acts on: base-sepolia | base-mainnet
NAPG_NETWORK=base-sepolia
# Path to the append-only audit SQLite DB
NAPG_AUDIT_DB=./audit.db
# HMAC key for audit-log tamper-evidence. Must be kept distinct from any wallet
# signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
NAPG_AUDIT_HMAC_KEY=
